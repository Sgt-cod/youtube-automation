# YouTube Data API v3 - console.cloud.google.com (gratuito)
YOUTUBE_API_KEY=coloque_sua_key_aqui

# Google AI Studio - aistudio.google.com/app/apikey (gratuito, sem cartao)
GEMINI_API_KEY=coloque_sua_key_aqui

# Necessario apenas para o upload (OAuth do dono do canal)
YOUTUBE_OAUTH_CLIENT_SECRETS=client_secrets.json
