# YouTube Data API v3 - console.cloud.google.com (gratuito)
YOUTUBE_API_KEY=coloque_sua_key_aqui

# Google AI Studio - aistudio.google.com/app/apikey (gratuito, sem cartao)
GEMINI_API_KEY=coloque_sua_key_aqui

# Necessario apenas para o upload (OAuth do dono do canal)
YOUTUBE_OAUTH_CLIENT_SECRETS=client_secrets.json

# --- Corte longo (pipeline_long.py) ---
# Telegram: crie um bot no @BotFather (token) e descubra seu chat id mandando
# uma mensagem pro bot e abrindo https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=coloque_o_token_do_bot
TELEGRAM_CHAT_ID=coloque_seu_chat_id
# THUMB_WAIT_MINUTES=60          # quanto esperar pela thumbnail
# THUMB_TIMEOUT_ACTION=publish   # publish | private (se o tempo esgotar)
